<div nav-light="" class="page-default">
  <div class="page-inner">
  <div class="page-intro">
  <div class="shop-contain u-container customer-page">
    <h1 class="u-text-style-h3">{{ 'customer.addresses.title' | t }}</h1>
    {% paginate customer.addresses by 10 %}
      {% for address in customer.addresses %}
        <div class="cart-line_item"><div class="field_copy">{{ address | format_address }}</div></div>
      {% endfor %}
    {% endpaginate %}
    {% form 'customer_address', customer.new_address %}
      {{ form.errors | default_errors }}
      <input type="text" name="address[address1]" class="body-upper" placeholder="{{ 'customer.addresses.address1' | t }}">
      <input type="text" name="address[city]" class="body-upper" placeholder="{{ 'customer.addresses.city' | t }}">
      <input type="text" name="address[zip]" class="body-upper" placeholder="{{ 'customer.addresses.zip' | t }}">
      <button type="submit" class="checkout-button body-upper">{{ 'customer.addresses.add' | t }}</button>
    {% endform %}
  </div>
  </div>
  </div>
</div>

{% section 'footer-dark' %}
