<div nav-light="" class="page-default">
  <div class="page-inner">
  <div class="page-intro">
  <div class="shop-contain u-container customer-page">
    <h1 class="u-text-style-h3">{{ 'customer.reset_password.title' | t }}</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" class="body-upper" placeholder="{{ 'customer.reset_password.password' | t }}">
      <input type="password" name="customer[password_confirmation]" class="body-upper" placeholder="{{ 'customer.reset_password.password_confirm' | t }}">
      <button type="submit" class="checkout-button body-upper">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
  </div>
  </div>
</div>

{% section 'footer-dark' %}
