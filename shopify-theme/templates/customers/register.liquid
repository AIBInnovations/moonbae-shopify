<div nav-light="" class="page-default">
  <div class="page-inner">
  <div class="page-intro">
  <div class="shop-contain u-container customer-page">
    <h1 class="u-text-style-h3">{{ 'customer.register.title' | t }}</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <label for="FirstName" class="body-upper">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" name="customer[first_name]" id="FirstName" class="body-upper" autocomplete="given-name">
      <label for="LastName" class="body-upper">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" name="customer[last_name]" id="LastName" class="body-upper" autocomplete="family-name">
      <label for="Email" class="body-upper">{{ 'customer.register.email' | t }}</label>
      <input type="email" name="customer[email]" id="Email" class="body-upper" autocomplete="email" required>
      <label for="Password" class="body-upper">{{ 'customer.register.password' | t }}</label>
      <input type="password" name="customer[password]" id="Password" class="body-upper" autocomplete="new-password" required>
      <button type="submit" class="checkout-button body-upper">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
  </div>
  </div>
  </div>
</div>

{% section 'footer-dark' %}
