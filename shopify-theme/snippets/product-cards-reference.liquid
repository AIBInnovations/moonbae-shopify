{%- comment -%}
  The 38 product cards exactly as they appear in the reference build, rendered
  when the Featured products section has no collection selected (or the store has
  no products yet). Images are the reference photography, shipped in assets/.
{%- endcomment -%}

<div role="listitem" class="product-card w-dyn-item">
  <div class="product-block">
    <div class="product-img_wrap is-slider">
      <img src="{{ 'or-product-the-caddie-jacket-navy.jpg' | asset_url }}" alt="The Caddie Jacket [Navy]" class="img-contain is-slider" data-commerce-type="variation-image">
      <img src="{{ 'or-product-hover-1.jpg' | asset_url }}" alt="" class="product-hover_img" loading="auto">
      <a arrow-trigger="" href="/products/the-caddie-jacket-navy" class="slider-link w-inline-block">
        <div class="product-block_info">
          <div class="product-info">
            <div class="body-upper">The Caddie Jacket [Navy]</div>
            <p class="body-upper text-grey">(OR_CAD_N)</p>
          </div>
          <div class="product-btn_flex">
            <div class="price">R 3,200.00</div>
            <div arrow-wrap="" class="arrow-svg_holder">{% render 'icon-arrow' %}</div>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
