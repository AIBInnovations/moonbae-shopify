{%- comment -%}
    Templates whose first screen sits on a light ground need the nav's dark treatment
    from the server. The [nav-dark] / [nav-light] attributes only drive ScrollTrigger
    once the visitor scrolls, so without this the nav is white-on-white on load.
  {%- endcomment -%}
  {%- assign light_ground_templates = 'product,collection,list-collections,search,blog,cart' | split: ',' -%}
{%- assign nav_classes = 'nav-component' -%}
{%- if light_ground_templates contains template.name -%}
  {%- assign nav_classes = 'nav-component dark' -%}
{%- endif -%}
{% render 'section-class', classes: nav_classes %}

<div img-hover_wrap="" data-nav="closed" class="nav">
  <div data-menu-toggle="" class="overlay"></div>

  <nav class="menu">
    <div class="menu-bg">
      <div class="bg-panel_full">
        <div class="bg-panel_full-img">
          {% render 'img', image: section.settings.menu_bg_image, fallback: 'or-menu-bg.jpg', class: 'img-fill', sizes: '(max-width: 1440px) 100vw, 1440px' %}
          <div class="menu-extras">
            <div class="bg-panel_contain u-container">
              <div class="menu-bottom_layout u-grid-desktop m-centered">
                <div data-menu-fade="" class="menu-footer_col u-column-6">
                  <div class="menu-extras_logo">{%- if settings.logo_menu_crest != blank -%}<img src="{{ settings.logo_menu_crest | image_url: width: 1200 }}" alt="{{ shop.name | escape }}" class="brand-mark">{%- else -%}{% render 'icon-logo-crest-sm' %}{%- endif -%}</div>
                </div>
                <div data-menu-fade="" class="menu-footer_col u-column-4">
                  <div class="menu-bot_wrap">
                    <div class="u-text-style-alt">{{ section.settings.menu_tagline }}</div>
                  </div>
                </div>
                <div data-menu-fade="" class="menu-footer_col u-column-2">
                  <div class="product-info u-vflex-right-bottom">
                    <div class="u-text-style-alt">{{ section.settings.menu_location }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-panel first"></div>
      <div class="bg-panel"></div>
    </div>

    <div class="menu-inner">
      <div class="menu-contain u-container">
        <div class="menu-layout u-grid-desktop">
          <div data-menu-fade="" class="menu-img_wrap u-column-1">
            <div target-img_wrap="" class="menu-img_inner"></div>
          </div>
          <div class="menu-list_wrap u-column-5">
            <div img-hover_triggers-wrap="" class="menu-list">
              {%- comment -%}
                A Shopify menu drives the list when one is picked; otherwise the six
                manual link fields do, so the menu matches the reference on a new store.
              {%- endcomment -%}
              {%- assign menu_links = linklists[section.settings.menu].links -%}
              {%- if section.settings.menu != blank and menu_links.size > 0 -%}
                {%- for link in menu_links -%}
                  <div img-hover_trigger="" class="menu-list-item">
                    <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} class="menu-link w-inline-block{% if link.active %} w--current{% endif %}">
                      <h3 class="u-text-style-h2 is-menulink">{{ link.title }}</h3>
                    </a>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  {%- assign label_key = 'link_' | append: i | append: '_label' -%}
                  {%- assign url_key = 'link_' | append: i | append: '_url' -%}
                  {%- assign label = section.settings[label_key] -%}
                  {%- if label != blank -%}
                    {%- assign url = section.settings[url_key] | default: '/' -%}
                    <div img-hover_trigger="" class="menu-list-item">
                      <a href="{{ url }}"{% if url == request.path %} aria-current="page"{% endif %} class="menu-link w-inline-block{% if url == request.path %} w--current{% endif %}">
                        <h3 class="u-text-style-h2 is-menulink">{{ label }}</h3>
                      </a>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
          <div data-menu-fade="" class="menu-close_wrap u-column-1">
            <div h-flip="" data-menu-toggle="" class="menu-close">
              <div class="body-upper">{{ section.settings.close_label }}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="menu-contain u-container">
        <div class="menu-bottom_layout u-grid-desktop is-menu">
          <div data-menu-fade="" class="menu-footer_col u-column-5 col-start_7">
            <div class="menu-bot_wrap">
              {% render 'cart-drawer', variant: 'menu' %}
              <div h-flip="" sub-trigger="" class="text-link">
                <div class="body-upper">{{ section.settings.signup_label }}</div>
              </div>
            </div>
          </div>
          <div data-menu-fade="" class="menu-footer_col u-column-1">
            <div class="product-info u-vflex-right-bottom">
              <a h-flip="" href="{{ section.settings.social_url }}" target="_blank" class="text-link w-inline-block">
                <div class="body-upper">{{ section.settings.social_label }}</div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div target-imgs_hidden="" class="target-imgs_hidden">
        {%- assign menu_fallbacks = 'or-menu-hover-1.jpg,or-menu-hover-2.jpg,or-menu-hover-3.jpg,or-menu-hover-4.jpg' | split: ',' -%}
        {%- assign hover_count = 4 -%}
        {%- if section.settings.menu != blank and menu_links.size > 0 -%}
          {%- assign hover_count = menu_links.size -%}
        {%- else -%}
          {%- assign hover_count = 0 -%}
          {%- for i in (1..6) -%}
            {%- assign label_key = 'link_' | append: i | append: '_label' -%}
            {%- if section.settings[label_key] != blank -%}{%- assign hover_count = hover_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for i in (1..hover_count) -%}
          {%- assign key = 'menu_image_' | append: i -%}
          {%- assign fb_index = i | minus: 1 | modulo: 4 -%}
          {% render 'img', image: section.settings[key], fallback: menu_fallbacks[fb_index], class: 'img-fill' %}
        {%- endfor -%}
      </div>
    </div>
  </nav>
</div>

<nav class="orgc-nav">
  <div class="nav-contain u-container">
    <div class="nav-layout u-grid-column-2">
      <div class="nav-col is-mobile">
        <div h-fadeout="" role="button" data-menu-toggle="" class="menu-toggle">
          <div class="menu-toggle_line"></div>
          <div class="menu-toggle_line"></div>
          <div class="menu-text_wrap">
            <div class="menu-text_inner"><p class="body-upper">{{ section.settings.menu_label }}</p></div>
          </div>
        </div>
      </div>

      <div class="nav-col">
        <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %} class="nav-logo_link w-inline-block{% if request.page_type == 'index' %} w--current{% endif %}" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo_nav != blank -%}<img src="{{ settings.logo_nav | image_url: width: 1200 }}" alt="{{ shop.name | escape }}" class="brand-mark">{%- else -%}{% render 'icon-logo-nav' %}{%- endif -%}
        </a>
      </div>

      <div class="nav-col">
        <div h-fadeout="" role="button" data-menu-toggle="" class="menu-toggle is-desktop">
          <div class="menu-toggle_line"></div>
          <div class="menu-toggle_line"></div>
          <div class="menu-text_wrap">
            <div class="menu-text_inner"><p class="body-upper">{{ section.settings.menu_label }}</p></div>
          </div>
        </div>
        <div h-fadeout="" class="nav-links_layout">
          <a h-flip="" href="{{ section.settings.shop_url }}" class="nav-link is-desktop w-inline-block">
            <div class="body-upper">{{ section.settings.shop_label }}</div>
          </a>
          {% render 'cart-drawer', variant: 'nav' %}
        </div>
      </div>
    </div>
  </div>
</nav>

